{
  "name": "FreePDFConverter",
  "short_name": "FreePDF",
  "description": "Stitch screenshots, images and web pages into one continuous PDF, in your browser.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f4f4f1",
  "theme_color": "#313033",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
